{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "outDir": "dist/core",
    "rootDir": "core",
    "lib": ["ES2020"]
  },
  "include": ["core/**/*.ts"]
}
